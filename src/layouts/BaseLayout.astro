---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Signet — Your agent. Your authority.",
  description = "Autonomy requires boundaries. An open-source personal authority stack for AI agents: a cryptographic vault, selective proofs, and explicit policy.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- OpenGraph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Signet" />
    <meta property="og:type" content="website" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Signet",
      "description": "Cryptographic privacy for AI agents. ZK proofs, 3-tier data classification, MCP integration.",
      "url": "https://signet.tools",
      "author": {
        "@type": "Person",
        "name": "Jeremy McEntire",
        "url": "https://perardua.dev"
      },
      "license": "https://opensource.org/licenses/MIT",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Cross-platform",
      "programmingLanguage": "Rust"
    })} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;450;500;550;600;650;700&family=Libre+Caslon+Display&family=DM+Mono:wght@300;400;500&family=JetBrains+Mono:wght@300;400;500;600&display=swap" rel="stylesheet" />

    <!-- WebMCP shim (A6): expose Signet MCP metadata to agent-aware browsers -->
    <script>
      navigator.modelContext?.provideContext?.({
        tools: [
          {
            name: "get_signet_info",
            description: "Return Signet MCP server metadata",
            inputSchema: { type: "object", properties: {} },
            execute: async () => ({
              project: "signet",
              install: "cargo install --locked --git https://github.com/jmcentire/signet.git signet",
              setup: "/start",
              repository: "https://github.com/jmcentire/signet",
              policy_companion_server_card: "/.well-known/mcp/server-card.json",
            }),
          },
        ],
      });
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
