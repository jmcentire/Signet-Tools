name: signet-tools
audience: public
description: >
  Canonical signet.tools website for the Signet Personal Sovereign Agent Stack.
  Astro static output served by nginx on Fly.io (app signet-tools).
  Engraved seal branding, trust-model illustration, installation, and privacy.

domains:
  - marketing
  - web
  - cryptography
  - sovereignty

voice:
  tone: clear, security-literate, benefit-led
  principles:
    - Lead with what Signet does for the user, not implementation
    - Security properties explained without jargon
  anti-patterns:
    - Marketing that overpromises security guarantees
    - Heavy JavaScript for a static landing page

standards:
  code_review:
    - Astro static HTML/CSS, minimal client JavaScript
    - Accessible and fast-loading

connects_to:
  - signet

work_policy:
  require_active_tag: false
  linear:
    enabled: false
    require_issue: false
  git:
    block_commit_without_tag: false
    block_commit_without_linear: false
    block_push_without_tag: false
    block_push_without_linear: false
